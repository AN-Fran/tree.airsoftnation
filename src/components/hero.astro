---
import {
  closures,
  holidays,
  scheduleOverrides,
  specialOpenings,
  weeklySchedule,
} from "../config/store-hours";

const now = new Date();
const madridTime = new Date(
  now.toLocaleString("en-US", { timeZone: "Europe/Madrid" })
);

const day = madridTime.getDay();
const hour = madridTime.getHours();
const minutes = madridTime.getMinutes();
const todayStr = madridTime.toISOString().split("T")[0];

function timeToMinutes(value: string) {
  const [hours, mins] = value.split(":").map(Number);
  return hours * 60 + mins;
}

function isWithinRange(date: string, from: string, to: string) {
  return date >= from && date <= to;
}

function formatPeriods(periods: [string, string][]) {
  return periods.map(([open, close]) => `${open}-${close}`).join(" / ");
}

const closure = closures.find(({ from, to }) =>
  isWithinRange(todayStr, from, to)
);

const specialOpening = specialOpenings.find(({ date }) => date === todayStr);

const scheduleOverride = scheduleOverrides.find(({ from, to }) =>
  isWithinRange(todayStr, from, to)
);

const isHoliday = holidays.includes(todayStr);

let isOpen = false;
let message = "";
let detail = "";

if (closure) {
  message = `Cerrado · ${closure.reason}`;
} else {
  let periods: [string, string][] = [];
  let contextLabel = "";

  if (specialOpening) {
    periods = specialOpening.periods;
    contextLabel = specialOpening.reason || "Horario especial";
  } else if (isHoliday) {
    message = "Cerrado · Festivo nacional";
  } else if (scheduleOverride) {
    periods = scheduleOverride.schedule[day] || [];
    contextLabel = scheduleOverride.label;
  } else {
    periods = weeklySchedule[day] || [];
  }

  if (!message) {
    if (periods.length === 0) {
      message = contextLabel ? `Cerrado · ${contextLabel}` : "Cerrado hoy";
      if (scheduleOverride) {
        detail = "Mié-Vie 17:00-21:00";
      }
    } else {
      const currentMinutes = hour * 60 + minutes;
      isOpen = periods.some(([open, close]) => {
        return (
          currentMinutes >= timeToMinutes(open) &&
          currentMinutes < timeToMinutes(close)
        );
      });

      if (isOpen) {
        message = contextLabel ? `Abierto ahora · ${contextLabel}` : "Abierto ahora";
      } else {
        message = contextLabel ? `Cerrado · ${contextLabel}` : "Cerrado";
      }

      detail = formatPeriods(periods);
    }
  }
}
---

<section class="hero">

  <div class="hero-inner">

    <a href="/" class="logo-link" aria-label="Ir a la página principal de Airsoft Nation">
      <img src="/logo_airsoft_nation.svg" alt="Airsoft Nation" class="logo" />
    </a>

    <p class="tagline">
      Comunidad · Juego · Evolución táctica
    </p>

    <div class={`store-status ${isOpen ? "open" : "closed"}`}>
      <i class={`bi ${isOpen ? "bi-circle-fill" : "bi-x-circle-fill"}`}></i>
      <div class="store-status-copy">
        <span>{message}</span>
        {detail && <small>{detail}</small>}
      </div>
    </div>

  </div>

</section>

<style>
.hero {
  padding: 32px 18px 10px;
  display: flex;
  justify-content: center;
}

.hero-inner {
  width: 100%;
  max-width: 380px;
  text-align: center;
}

.logo-link {
  display: inline-block;
}

.logo {
  width: 150px;
  margin: 0 auto 14px;
  display: block;
}

.title {
  font-family: "Oswald", sans-serif;
  font-weight: 600;
  font-size: 1.8rem;
  letter-spacing: 1px;
  margin: 0;
}

.tagline {
  margin-top: 8px;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.store-status {
  margin-top: 16px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 20px;
  background: var(--bg-card);
}

.store-status-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
}

.store-status-copy small {
  font-size: 0.72rem;
  font-weight: 500;
  color: var(--text-muted);
}

.store-status.open {
  color: #22c55e;
}

.store-status.closed {
  color: #E02B20;
}

.store-status i {
  font-size: 10px;
}
</style>
