---
import MainLayout from "../../../layouts/MainLayout.astro";
import { hpaEngines } from "../../../data/hpa-products";

const title = "Engines HPA: INFERNO, JACK y F2 | Airsoft Nation";
const description = "Compara el ciclo y la arquitectura de Wolverine INFERNO Gen 2, INFERNO XTS, PolarStar JACK y F2 antes de abrir su ficha técnica.";
const canonical = "https://tree.airsoftnation.eu/hpa/engines/";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://tree.airsoftnation.eu/" },
    { "@type": "ListItem", position: 2, name: "HPA", item: "https://tree.airsoftnation.eu/hpa/" },
    { "@type": "ListItem", position: 3, name: "Engines HPA", item: canonical },
  ],
};
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Engines HPA documentados por Airsoft Nation",
  itemListElement: hpaEngines.map((engine, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `https://tree.airsoftnation.eu${engine.route}`,
    name: engine.name,
  })),
};
---

<MainLayout title={title} description={description} canonical={canonical} image={hpaEngines[0].imageUrl} structuredData={[breadcrumbSchema, itemListSchema]}>
  <main class="catalogue">
    <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/hpa/guia/">Guía HPA</a><span>/</span><span>Engines</span></nav>
    <header>
      <p class="eyebrow">HPA Knowledge</p>
      <h1>Cuatro engines, cuatro fichas</h1>
      <p>Cada página separa la arquitectura publicada por el fabricante de las pruebas que Airsoft Nation todavía no ha realizado.</p>
    </header>

    <a class="cycle-link" href="/hpa/engines/bolt-abierto-cerrado-hibrido/">
      <span><strong>Antes de comparar</strong><small>Entiende bolt abierto, cerrado e híbrido.</small></span><b aria-hidden="true">›</b>
    </a>

    <div class="grid">
      {hpaEngines.map((engine) => (
        <article class="card">
          <a class="image-link" href={engine.destinationUrl} target="_blank" rel="noopener noreferrer" aria-label={`${engine.destinationLabel}: ${engine.name}`}>
            <img src={engine.imageUrl} alt={engine.imageAlt} loading="lazy" />
            <span>{engine.destinationLabel} ↗</span>
          </a>
          <div class="copy">
            <small>{engine.manufacturer}</small>
            <h2><a href={engine.route}>{engine.name}</a></h2>
            <div class="tags"><span>{engine.cycle}</span><span>{engine.solenoids}</span></div>
            <p>{engine.summary}</p>
            <a class="read" href={engine.route}>Leer ficha <span aria-hidden="true">›</span></a>
          </div>
        </article>
      ))}
    </div>

    <section class="valves">
      <p class="eyebrow">Evidencia técnica</p>
      <h2>Electroválvulas MAC específicas a 5 V</h2>
      <p><code>airsoftnation_tested</code> — Por experiencia directa de taller, Airsoft Nation identifica electroválvulas de la prestigiosa firma estadounidense MAC, diseñadas específicamente para cada engine y trabajando a 5 V, en las unidades HPA descritas en estas fichas y también en sistemas GATE y Redline.</p>
      <p>Esta identificación es una afirmación técnica propia de Airsoft Nation. No se presenta como especificación oficial de todas las marcas. Wolverine sí documenta el uso de MAC en la familia INFERNO; PolarStar documenta una MAC diseñada a medida para F1 y la regulación de su FCU a 5 V.</p>
      <div class="sources"><a href="https://www.wolverineairsoft.com/product/o-ring-kit-for-mac-valves/" target="_blank" rel="noopener noreferrer">Fuente Wolverine ↗</a><a href="https://archived.polarstarairsoft.com/prod-f1.php" target="_blank" rel="noopener noreferrer">Fuente PolarStar F1 ↗</a><a href="https://polarstarairsoft.com/apps/help-center" target="_blank" rel="noopener noreferrer">Ayuda PolarStar: 5 V ↗</a></div>
    </section>
  </main>
</MainLayout>

<style>
.catalogue{max-width:760px;margin:0 auto;padding-bottom:48px}.breadcrumbs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:28px;color:var(--text-muted);font-size:.76rem}.eyebrow{margin:0 0 9px;color:#6ee7d1;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.catalogue h1{font-size:clamp(2rem,10vw,3.2rem);line-height:1.05}.catalogue header>p:last-child{margin-top:14px;color:var(--text-soft);line-height:1.6}.cycle-link{display:flex;align-items:center;gap:12px;margin-top:24px;padding:14px;border:1px solid var(--border-soft);border-radius:12px;background:var(--bg-card)}.cycle-link span{display:grid;gap:3px;flex:1}.cycle-link small{color:var(--text-muted)}.cycle-link b{color:#6ee7d1;font-size:1.7rem}.grid{display:grid;gap:14px;margin-top:18px}.card{overflow:hidden;border:1px solid var(--border-soft);border-radius:14px;background:var(--bg-card)}.image-link{position:relative;display:block;aspect-ratio:16/9;background:#eef1f3;overflow:hidden}.image-link img{width:100%;height:100%;object-fit:contain;padding:10px;transition:transform .25s}.image-link:hover img{transform:scale(1.025)}.image-link span{position:absolute;left:9px;bottom:9px;padding:6px 8px;border-radius:7px;background:rgba(6,22,48,.92);color:#fff;font-size:.68rem;font-weight:600}.copy{padding:15px}.copy>small{color:#6ee7d1;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em}.copy h2{margin:6px 0 9px;font-size:1.2rem}.copy h2 a:hover{color:#6ee7d1}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}.tags span{padding:4px 7px;border-radius:999px;background:rgba(0,184,148,.12);color:#8ce9d9;font-size:.66rem}.copy p{display:-webkit-box;overflow:hidden;-webkit-line-clamp:3;-webkit-box-orient:vertical;color:var(--text-soft);font-size:.82rem;line-height:1.55}.read{display:inline-flex;gap:6px;margin-top:12px;color:#6ee7d1;font-size:.8rem;font-weight:600}.valves{margin-top:32px;padding:18px;border:1px solid var(--border-soft);border-radius:14px;background:var(--bg-card)}.valves h2{margin-bottom:12px;font-size:1.3rem}.valves p:not(.eyebrow){color:var(--text-soft);font-size:.82rem;line-height:1.65}.valves p+p{margin-top:10px}.valves code{color:#6ee7d1;overflow-wrap:anywhere}.sources{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.sources a{padding:7px 9px;border:1px solid var(--border-soft);border-radius:8px;color:#6ee7d1;font-size:.72rem}@media(min-width:640px){.grid{grid-template-columns:1fr 1fr}}
</style>
